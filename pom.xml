<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>ECF-Notificador</artifactId>
    <version>2.0</version>
    <packaging>jar</packaging>

    <name>ECF-Notificador</name>
    <description>
        Notificador de atualizacoes do programa ECF (Escrituracao Contabil
        Fiscal) da Receita Federal. Aplicacao desktop Windows.
    </description>

    <properties>
        <flatlafVersion>3.4</flatlafVersion>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <nativeMavenPluginVersion>1.1.12</nativeMavenPluginVersion>

        <jacksonVersion>2.22.2</jacksonVersion>
        <jnaVersion>5.19.1</jnaVersion>
        <slf4jVersion>2.0.9</slf4jVersion>
        <jsoupVersion>1.18.3</jsoupVersion>

        <assertjVersion>3.26.3</assertjVersion>
        <wiremockVersion>3.10.0</wiremockVersion>

        <compilerPluginVersion>3.16.0</compilerPluginVersion>
        <jarPluginVersion>3.5.1</jarPluginVersion>
        <shadePluginVersion>3.6.2</shadePluginVersion>

        <junitVersion>5.11.4</junitVersion>
        <surefireVersion>3.6.0</surefireVersion>
        <jacocoVersion>0.8.15</jacocoVersion>
        <!-- Medido: 76,3% de instrucoes. -->
        <coverageMinimum>0.70</coverageMinimum>

        <checkstylePluginVersion>3.6.0</checkstylePluginVersion>
        <checkstyleVersion>14.1.0</checkstyleVersion>
        <pmdPluginVersion>3.28.0</pmdPluginVersion>
        <spotbugsPluginVersion>4.10.4.1</spotbugsPluginVersion>
        <findsecbugsVersion>1.14.0</findsecbugsVersion>

        <cyclonedxVersion>2.9.3</cyclonedxVersion>

        <enforcerVersion>3.6.3</enforcerVersion>
        <pitestVersion>1.19.0</pitestVersion>
        <pitestJunit5Version>1.2.1</pitestJunit5Version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Alinha jupiter, platform e launcher na mesma versao: o goal
                 `test` do native-maven-plugin exige launcher e engines
                 compativeis. -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junitVersion}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jacksonVersion}</version>
        </dependency>
        <!-- API e implementacao declaradas explicitamente: o codigo importa
             org.slf4j diretamente em 13 classes. Depender da versao trazida
             transitivamente pelo slf4j-simple quebra o build se a
             implementacao for trocada (ex.: logback). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4jVersion}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4jVersion}</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>${jnaVersion}</version>
        </dependency>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>${flatlafVersion}</version>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoupVersion}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Exigido pelo goal `test` do native-maven-plugin. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertjVersion}</version>
            <scope>test</scope>
        </dependency>
        <!-- Simula o servidor da Receita Federal nos testes de resiliencia. -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremockVersion}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compilerPluginVersion}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${jarPluginVersion}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>app.App</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${shadePluginVersion}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Assinaturas quebram o fat JAR apos o merge. -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- Modulo de dependencia nao pode ser mesclado. -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <!--
                                    Mescla META-INF/services das dependencias.
                                    JNA e Jackson registram provedores via
                                    ServiceLoader; sem isso o fat JAR perde
                                    esses registros.
                                -->
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ==================== Testes unitarios ==================== -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefireVersion}</version>
                <configuration>
                    <!-- Testes de UI precisam de bandeja/janelas reais. -->
                    <excludedGroups>ui</excludedGroups>
                    <trimStackTrace>false</trimStackTrace>
                    <systemPropertyVariables>
                        <!-- O popup nativo e modal: nao pode ser exibido. -->
                        <java.awt.headless>true</java.awt.headless>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacocoVersion}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverageMinimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <excludes>
                                <!-- UI nativa (Win32 via JNA): so executa no
                                     binario nativo em Windows, impossivel de
                                     exercitar na suite Linux/headless. As
                                     partes puras sao cobertas por testes
                                     dedicados (NativeTrayServiceTest). -->
                                <exclude>app/service/win32/**</exclude>
                                <exclude>app/form/NativeConfigDialog</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ============ Analise estatica (papel do Sonar) ============ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstylePluginVersion}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyleVersion}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>${project.basedir}/config/checkstyle/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <!-- Apenas violacoes de severidade ERROR falham o build. -->
                    <violationSeverity>error</violationSeverity>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-verify</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${pmdPluginVersion}</version>
                <configuration>
                    <!-- Reporta os achados sem bloquear o merge; a regra de
                         tipagem (proibido var) fica no Checkstyle. -->
                    <failOnViolation>false</failOnViolation>
                    <printFailingErrors>true</printFailingErrors>
                    <targetJdk>${maven.compiler.release}</targetJdk>
                    <rulesets>
                        <ruleset>${project.basedir}/config/pmd/pmd-ruleset.xml</ruleset>
                    </rulesets>
                </configuration>
                <executions>
                    <execution>
                        <id>pmd-verify</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugsPluginVersion}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <!-- Publica o relatorio sem bloquear por achados pre-existentes. -->
                    <failOnError>false</failOnError>
                    <excludeFilterFile>${project.basedir}/config/spotbugs/spotbugs-exclude.xml</excludeFilterFile>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${findsecbugsVersion}</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-verify</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ===== SBOM: inventario de dependencias (CVE/VEX) ===== -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedxVersion}</version>
                <executions>
                    <execution>
                        <id>make-sbom</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>makeAggregateBom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${enforcerVersion}</version>
                <executions>
                    <execution>
                        <id>enforce-versions</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.8,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Executavel .exe sem JVM. REQUER JDK GraalVM 25 (nao serve Temurin).
             Uso: mvn -Pnative -DskipTests package
             Saida: target/ECF-Notificador.exe
             O binario perde bandeja e tela de Configuracoes (AWT/Swing nao tem
             suporte no Native Image). Ver docs/NATIVE.md. -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${nativeMavenPluginVersion}</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>ECF-Notificador</imageName>
                            <mainClass>app.App</mainClass>
                            <metadataRepository>
                                <enabled>true</enabled>
                            </metadataRepository>
                            <buildArgs>
                                <!-- Sem "no-fallback" o build pode "passar"
                                     gerando um binario que ainda precisa de JVM. -->
                                <buildArg>--no-fallback</buildArg>
                                <!-- HttpClient chama o Gist e a RFB por HTTPS. -->
                                <buildArg>--enable-url-protocols=https</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Compila e roda os TESTES como imagem nativa.
             Uso: mvn -Pnative-test test
             Exclui os testes marcados "servidor" (WireMock sobe Jetty) e "ui". -->
        <profile>
            <id>native-test</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${surefireVersion}</version>
                        <configuration>
                            <excludedGroups>ui,servidor</excludedGroups>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${nativeMavenPluginVersion}</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>native-tests-build</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>ecf-notificador-tests</imageName>
                            <metadataRepository>
                                <enabled>true</enabled>
                            </metadataRepository>
                            <buildArgs>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Mutation testing da logica de dominio. Intencionalmente separado
             do verify: e mais caro e nao deve bloquear o feedback cotidiano. -->
        <profile>
            <id>mutation</id>
            <properties>
                <!-- PIT 1.19 ainda nao interpreta bytecode Java 25 (major 69).
                     O alvo de mutacao usa apenas APIs compativeis com Java 21. -->
                <maven.compiler.release>21</maven.compiler.release>
                <jacoco.skip>true</jacoco.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitestVersion}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitestJunit5Version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>app.utils.VersionComparator</param>
                                <param>app.utils.TextSanitizer</param>
                            </targetClasses>
                            <targetTests>
                                <param>app.utils.TextSanitizerTest</param>
                                <param>app.utils.VersionComparatorTest</param>
                            </targetTests>
                            <excludedClasses>
                                <param>app.service.NotificationService*</param>
                                <param>app.service.TaskDialogService*</param>
                                <param>app.service.TrayIconService*</param>
                                <param>app.utils.ThemeService*</param>
                                <param>app.utils.IconLoader*</param>
                                <param>app.service.EcfLatestVersionServiceHttpTest*</param>
                                <param>app.service.GistSettingsLoaderHttpTest*</param>
                                <param>app.service.UpdateFlowEndToEndTest*</param>
                                <param>app.service.ConfigurationContractTest*</param>
                            </excludedClasses>
                            <excludedTestClasses>
                                <param>*HttpTest</param>
                                <param>*EndToEndTest</param>
                                <param>*TestUtil*</param>
                            </excludedTestClasses>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                            <mutationThreshold>60</mutationThreshold>
                            <timeoutConstant>30000</timeoutConstant>
                            <timeoutFactor>2.0</timeoutFactor>
                            <jvmArgs>
                                <jvmArg>-Djava.awt.headless=true</jvmArg>
                            </jvmArgs>
                            <threads>2</threads>
                            <timestampedReports>false</timestampedReports>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
